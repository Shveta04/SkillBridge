@page "/Admin/Jobs"
@model SkillBridge.Pages.Admin.JobsModel

@{
    Layout = "/Pages/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage Jobs";
}

<style>
    .jobs-page {
        background: #f2f9f8;
        min-height: calc(100vh - 80px);
        padding: 32px 42px 55px;
    }

    /* =========================
           PAGE HEADER
           ========================= */

    .jobs-header {
        background: #ffffff;
        border: 1px solid #d7ebe9;
        border-radius: 0 0 28px 28px;
        padding: 34px 42px;
        margin: -32px -42px 28px;
    }

    .jobs-header-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 25px;
    }

    .jobs-section-label {
        color: #10b3a3;
        font-size: 14px;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .jobs-title {
        color: #123b3b;
        font-size: 42px;
        line-height: 1.15;
        font-weight: 800;
        margin: 0 0 8px;
    }

        .jobs-title span {
            color: #123b3b;
        }

    .jobs-subtitle {
        color: #628080;
        font-size: 17px;
        margin: 0;
    }

    /* =========================
           DASHBOARD BUTTON
           ========================= */

    .dashboard-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        color: #008d83;
        background: #ffffff;
        border: 1px solid #bfe4e0;
        border-radius: 14px;
        padding: 12px 22px;
        font-size: 16px;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

        .dashboard-btn:hover {
            background: #e9f8f6;
            color: #007d75;
            border-color: #10b3a3;
        }

    /* =========================
           JOB CARD
           ========================= */

    .jobs-card {
        background: #ffffff;
        border: 1px solid #d7ebe9;
        border-radius: 26px;
        padding: 30px;
        box-shadow: 0 8px 30px rgba(18, 59, 59, 0.04);
    }

    .jobs-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    .jobs-card-title {
        color: #123b3b;
        font-size: 29px;
        font-weight: 800;
        margin: 0 0 5px;
    }

    .jobs-card-subtitle {
        color: #6a8585;
        font-size: 15px;
        margin: 0;
    }

    .jobs-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 95px;
        padding: 11px 18px;
        border-radius: 30px;
        background: #e9f8f6;
        border: 1px solid #c9ece7;
        color: #008d83;
        font-size: 14px;
        font-weight: 800;
        white-space: nowrap;
    }

    /* =========================
           TABLE
           ========================= */

    .jobs-table-wrapper {
        width: 100%;
        overflow-x: auto;
        border: 1px solid #cfe8e5;
        border-radius: 16px;
    }

    .jobs-table {
        width: 100%;
        min-width: 1050px;
        border-collapse: separate;
        border-spacing: 0;
        margin: 0;
    }

        .jobs-table thead th {
            background: #eef9f8;
            color: #285c5c;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            padding: 15px 17px;
            border-bottom: 1px solid #cfe8e5;
            white-space: nowrap;
        }

            .jobs-table thead th:first-child {
                border-top-left-radius: 15px;
            }

            .jobs-table thead th:last-child {
                border-top-right-radius: 15px;
            }

        .jobs-table tbody td {
            background: #ffffff;
            color: #5d7777;
            font-size: 14px;
            font-weight: 400;
            padding: 17px;
            border-bottom: 1px solid #e3efee;
            vertical-align: middle;
        }

        .jobs-table tbody tr:last-child td {
            border-bottom: none;
        }

        .jobs-table tbody tr:hover td {
            background: #fbfefe;
        }

        /* Column sizing */

        .jobs-table th:nth-child(1),
        .jobs-table td:nth-child(1) {
            width: 6%;
        }

        .jobs-table th:nth-child(2),
        .jobs-table td:nth-child(2) {
            width: 17%;
        }

        .jobs-table th:nth-child(3),
        .jobs-table td:nth-child(3) {
            width: 17%;
        }

        .jobs-table th:nth-child(4),
        .jobs-table td:nth-child(4) {
            width: 10%;
        }

        .jobs-table th:nth-child(5),
        .jobs-table td:nth-child(5) {
            width: 14%;
        }

        .jobs-table th:nth-child(6),
        .jobs-table td:nth-child(6) {
            width: 13%;
        }

        .jobs-table th:nth-child(7),
        .jobs-table td:nth-child(7) {
            width: 16%;
        }

        .jobs-table th:nth-child(8),
        .jobs-table td:nth-child(8) {
            width: 7%;
        }

    /* =========================
           TABLE CONTENT
           ========================= */

    .job-id {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 50px;
        padding: 8px 11px;
        border-radius: 10px;
        background: #eef9f8;
        color: #008d83;
        font-size: 13px;
        font-weight: 800;
    }

    .job-title {
        color: #123b3b !important;
        font-size: 14px;
        line-height: 1.35;
        font-weight: 800;
    }

    .company-name {
        color: #123b3b !important;
        font-size: 14px;
        line-height: 1.35;
        font-weight: 700;
    }

    .location {
        color: #627d7d;
        font-size: 14px;
        line-height: 1.4;
    }

    .location-pin {
        color: #e85d75;
        margin-right: 4px;
    }

    .skills {
        color: #627d7d;
        font-size: 13px;
        line-height: 1.45;
    }

    /* =========================
           JOB TYPE
           ========================= */

    .job-type-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 14px;
        border-radius: 25px;
        background: #e9f8f6;
        border: 1px solid #c9ece7;
        color: #008d83;
        font-size: 12px;
        font-weight: 800;
        white-space: nowrap;
    }

    /* =========================
           APPLY BUTTON
           ========================= */

    .apply-job-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        color: #008d83;
        background: #e9f8f6;
        border: 1px solid #c9ece7;
        border-radius: 10px;
        padding: 8px 13px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none !important;
        white-space: nowrap;
        cursor: pointer;
        position: relative;
        z-index: 5;
        pointer-events: auto;
        transition: all 0.2s ease;
    }

        .apply-job-btn:hover {
            background: #10b3a3;
            border-color: #10b3a3;
            color: #ffffff;
        }

    /* =========================
           EDIT BUTTON
           ========================= */

    .edit-job-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        min-width: 82px;
        color: #ffffff !important;
        background: #10b3a3 !important;
        border: 1px solid #10b3a3 !important;
        border-radius: 11px;
        padding: 10px 13px;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none !important;
        cursor: pointer !important;
        position: relative;
        z-index: 100;
        pointer-events: auto !important;
        transition: all 0.2s ease;
    }

        .edit-job-btn:hover {
            background: #008d83 !important;
            border-color: #008d83 !important;
            color: #ffffff !important;
            transform: translateY(-1px);
        }

        .edit-job-btn:active {
            transform: translateY(0);
        }

    /* =========================
           EMPTY STATE
           ========================= */

    .empty-jobs {
        text-align: center;
        padding: 60px 20px;
        color: #6a8585;
    }

        .empty-jobs h4 {
            color: #123b3b;
            font-size: 21px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .empty-jobs p {
            margin: 0;
            font-size: 14px;
        }

    /* =========================
           RESPONSIVE
           ========================= */

    @@media (max-width: 900px) {

        .jobs-page {
            padding: 25px 20px 45px;
        }

        .jobs-header {
            margin: -25px -20px 25px;
            padding: 30px 25px;
        }

        .jobs-header-top {
            flex-direction: column;
        }

        .jobs-title {
            font-size: 34px;
        }

        .jobs-subtitle {
            font-size: 16px;
        }

        .jobs-card {
            padding: 20px;
        }

        .jobs-card-title {
            font-size: 25px;
        }
    }
</style>


<div class="jobs-page">

    <!-- =========================
         PAGE HEADER
         ========================= -->

    <div class="jobs-header">

        <div class="jobs-header-top">

            <div>

                <div class="jobs-section-label">
                    Job Management
                </div>

                <h1 class="jobs-title">
                    Manage <span>Jobs</span>
                </h1>

                <p class="jobs-subtitle">
                    View and manage job postings on SkillBridge.
                </p>

            </div>

            <div>

                <a href="/Admin/Dashboard"
                   class="dashboard-btn">
                    ← Dashboard
                </a>

            </div>

        </div>

    </div>


    <!-- =========================
         JOB POSTINGS CARD
         ========================= -->

    <div class="jobs-card">

        <div class="jobs-card-header">

            <div>

                <h2 class="jobs-card-title">
                    Job Postings
                </h2>

                <p class="jobs-card-subtitle">
                    Jobs currently posted on SkillBridge.
                </p>

            </div>

            <div class="jobs-count">
                @Model.Jobs.Count @(Model.Jobs.Count == 1 ? "Job" : "Jobs")
            </div>

        </div>


        @if (Model.Jobs != null && Model.Jobs.Count > 0)
        {
            <div class="jobs-table-wrapper">

                <table class="jobs-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Job Title</th>
                            <th>Company</th>
                            <th>Apply</th>
                            <th>Location</th>
                            <th>Job Type</th>
                            <th>Required Skills</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var job in Model.Jobs)
                        {
                            <tr>

                                <!-- ID -->
                                <td>
                                    <span class="job-id">
                                        #@job.JobID
                                    </span>
                                </td>

                                <!-- JOB TITLE -->
                                <td>
                                    <div class="job-title">
                                        @job.JobTitle
                                    </div>
                                </td>

                                <!-- COMPANY -->
                                <td>
                                    <div class="company-name">
                                        @job.CompanyName
                                    </div>
                                </td>

                                <!-- APPLY -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(job.ApplyLink))
                                    {
                                        <a href="@job.ApplyLink"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="apply-job-btn">
                                            View →
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="skills">
                                            Not provided
                                        </span>
                                    }

                                </td>

                                <!-- LOCATION -->
                                <td>
                                    <div class="location">
                                        <span class="location-pin">📍</span>
                                        @job.Location
                                    </div>
                                </td>

                                <!-- JOB TYPE -->
                                <td>
                                    <span class="job-type-badge">
                                        @job.JobType
                                    </span>
                                </td>

                                <!-- REQUIRED SKILLS -->
                                <td>
                                    <div class="skills">
                                        @job.RequiredSkills
                                    </div>
                                </td>

                                <!-- EDIT -->
                                <td>

                                    <a href="/Admin/EditJob?id=@job.JobID"
                                       class="edit-job-btn">
                                        Edit →
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-jobs">

                <h4>No jobs found</h4>

                <p>
                    There are currently no job postings.
                </p>

            </div>
        }

    </div>

</div>