@page
@model SkillBridge.Pages.Admin.ResumesModel

@{
    Layout = "/Pages/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage Resumes";
}

<style>
    .resumes-page {
        padding: 36px 44px;
        background: #f2faf8;
        min-height: calc(100vh - 80px);
    }

    /* Header */
    .resumes-header {
        background: #ffffff;
        border: 1px solid #d6eeea;
        border-radius: 24px;
        padding: 34px 42px;
        margin-bottom: 28px;
    }

    .resumes-label {
        color: #10b3a3;
        font-size: 14px;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .resumes-header h1 {
        margin: 0;
        color: #123b36;
        font-size: 42px;
        font-weight: 800;
    }

    .resumes-header p {
        margin: 10px 0 0;
        color: #64817d;
        font-size: 17px;
    }

    /* Dashboard button */
    .dashboard-btn {
        display: inline-block;
        background: #ffffff;
        color: #008d83;
        border: 1px solid #bfe5e0;
        border-radius: 12px;
        padding: 11px 20px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        transition: 0.2s ease;
    }

        .dashboard-btn:hover {
            background: #e9f8f6;
            color: #00776f;
            border-color: #10b3a3;
        }

    /* Main card */
    .resumes-card {
        background: #ffffff;
        border: 1px solid #d6eeea;
        border-radius: 24px;
        padding: 34px 42px;
        box-shadow: 0 8px 24px rgba(16, 179, 163, 0.06);
    }

    .resumes-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 26px;
    }

    .resumes-card-title h2 {
        margin: 0;
        color: #123b36;
        font-size: 28px;
        font-weight: 800;
    }

    .resumes-card-title p {
        margin: 6px 0 0;
        color: #64817d;
        font-size: 14px;
    }

    /* Count */
    .resume-count {
        background: #e9f8f6;
        color: #008d83;
        border: 1px solid #c9ece7;
        border-radius: 999px;
        padding: 10px 18px;
        font-size: 14px;
        font-weight: 800;
        white-space: nowrap;
    }

    /* Table */
    .resumes-table-wrapper {
        overflow-x: auto;
        border: 1px solid #d6eeea;
        border-radius: 16px;
    }

    .resumes-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 700px;
    }

        .resumes-table thead {
            background: #eef9f7;
        }

        .resumes-table th {
            color: #285d57;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            padding: 16px 18px;
            border-bottom: 1px solid #d6eeea;
            text-align: left;
            white-space: nowrap;
        }

        .resumes-table td {
            color: #315f59;
            font-size: 14px;
            padding: 17px 18px;
            border-bottom: 1px solid #edf5f3;
            vertical-align: middle;
        }

        .resumes-table tbody tr:last-child td {
            border-bottom: none;
        }

        .resumes-table tbody tr:hover {
            background: #f8fcfb;
        }

    /* ID badge */
    .resume-id {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 42px;
        height: 34px;
        padding: 0 10px;
        background: #eef9f7;
        color: #008d83;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 800;
    }

    /* User name */
    .resume-user {
        color: #123b36;
        font-weight: 700;
    }

    /* Email */
    .resume-email {
        color: #64817d;
    }

    /* View Resume button */
    .view-resume-btn {
        display: inline-block;
        background: #e9f8f6;
        color: #008d83;
        border: 1px solid #c9ece7;
        border-radius: 10px;
        padding: 9px 15px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: 0.2s ease;
        white-space: nowrap;
    }

        .view-resume-btn:hover {
            background: #10b3a3;
            color: #ffffff;
            border-color: #10b3a3;
        }

    /* No resumes */
    .no-resumes {
        text-align: center;
        padding: 60px 20px;
    }

    .no-resumes-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: #e9f8f6;
        color: #10b3a3;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: 800;
    }

    .no-resumes h3 {
        margin: 0 0 8px;
        color: #123b36;
        font-size: 22px;
        font-weight: 800;
    }

    .no-resumes p {
        margin: 0;
        color: #64817d;
        font-size: 14px;
    }

    /* Mobile */
    @@media (max-width: 768px) {

        .resumes-page {
            padding: 24px 18px;
        }

        .resumes-header,
        .resumes-card {
            padding: 26px 22px;
        }

            .resumes-header h1 {
                font-size: 32px;
            }

            .resumes-header .d-flex {
                flex-direction: column;
                align-items: flex-start !important;
                gap: 18px;
            }

        .resumes-card-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }
    }
</style>


<div class="resumes-page">

    <!-- Header -->
    <div class="resumes-header">

        <div class="d-flex justify-content-between align-items-center">

            <div>

                <div class="resumes-label">
                    RESUME MANAGEMENT
                </div>

                <h1>
                    Manage Resumes
                </h1>

                <p>
                    View resumes submitted by SkillBridge users.
                </p>

            </div>

            <a asp-page="/Admin/Dashboard"
               class="dashboard-btn">
                ← Dashboard
            </a>

        </div>

    </div>


    <!-- Resumes Card -->
    <div class="resumes-card">

        <div class="resumes-card-header">

            <div class="resumes-card-title">

                <h2>
                    Submitted Resumes
                </h2>

                <p>
                    Resumes currently submitted by registered users.
                </p>

            </div>

            <div class="resume-count">
                @Model.UsersWithResumes.Count Resume@(Model.UsersWithResumes.Count == 1 ? "" : "s")
            </div>

        </div>


        @if (Model.UsersWithResumes.Count > 0)
        {
            <div class="resumes-table-wrapper">

                <table class="resumes-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>User</th>
                            <th>Email</th>
                            <th>Resume</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var user in Model.UsersWithResumes)
                        {
                            <tr>

                                <td>
                                    <span class="resume-id">
                                        #@user.UserID
                                    </span>
                                </td>

                                <td>
                                    <span class="resume-user">
                                        @user.FullName
                                    </span>
                                </td>

                                <td>
                                    <span class="resume-email">
                                        @user.Email
                                    </span>
                                </td>

                                <td>

                                    @if (!string.IsNullOrEmpty(user.ResumePath))
                                    {
                                        <a asp-page-handler="ViewResume"
                                           asp-route-id="@user.UserID"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="view-resume-btn">

                                            <i class="bi bi-eye-fill"></i>
                                            View Resume

                                        </a>
                                    }
                                    else
                                    {
                                        <span class="resume-email">
                                            Not available
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="no-resumes">

                <div class="no-resumes-icon">
                    📄
                </div>

                <h3>
                    No Resumes Submitted
                </h3>

                <p>
                    Users who upload resumes will appear here.
                </p>

            </div>
        }

    </div>

</div>+