@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - SkillBridge Admin
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css" />

    <style>

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: #f4fbf9;
                color: #163b38;
                font-family: Arial, Helvetica, sans-serif;
            }

            /* =========================================
                       ADMIN LAYOUT
                       ========================================= */

            .admin-layout {
                min-height: 100vh;
                display: flex;
            }


            /* =========================================
                       SIDEBAR
                       ========================================= */

            .admin-sidebar {
                width: 255px;
                min-height: 100vh;
                background: #ffffff;
                border-right: 1px solid #dcefeb;
                padding: 28px 18px;
                position: fixed;
                left: 0;
                top: 0;
                bottom: 0;
                z-index: 1000;
                box-shadow: 4px 0 20px rgba(22, 59, 56, 0.04);
            }


            /* BRAND */

            .sidebar-brand {
                padding: 5px 14px 28px;
                border-bottom: 1px solid #e5f1ef;
                margin-bottom: 25px;
            }

            .sidebar-logo {
                font-size: 30px;
                font-weight: 900;
                letter-spacing: -1.5px;
                color: #163b38;
            }

                .sidebar-logo span {
                    color: #10b5a4;
                }

            .sidebar-tagline {
                margin-top: 7px;
                color: #78918d;
                font-size: 9px;
                font-weight: 700;
                letter-spacing: 2px;
            }


            /* ADMIN LABEL */

            .sidebar-label {
                padding: 0 14px;
                margin-bottom: 10px;
                color: #8aa19d;
                font-size: 10px;
                font-weight: 800;
                letter-spacing: 2px;
            }


            /* NAVIGATION */

            .admin-nav {
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

            .admin-nav-link {
                display: flex;
                align-items: center;
                gap: 13px;
                min-height: 50px;
                padding: 10px 14px;
                border-radius: 14px;
                color: #58736f;
                text-decoration: none;
                font-size: 14px;
                font-weight: 600;
                transition: all 0.2s ease;
                border: 1px solid transparent;
            }

                .admin-nav-link:hover {
                    background: #f0fbf9;
                    color: #087f73;
                    border-color: #d7efeb;
                    transform: translateX(3px);
                }

                .admin-nav-link.active {
                    background: #e8f8f5;
                    color: #087f73;
                    font-weight: 700;
                    border-color: #c7eee8;
                    box-shadow: 0 4px 12px rgba(16, 181, 164, 0.08);
                }


            /* NAVIGATION ICON */

            .nav-icon {
                width: 34px;
                height: 34px;
                min-width: 34px;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #f1faf8;
                color: #10b5a4;
                font-size: 16px;
                transition: all 0.2s ease;
            }

            .admin-nav-link:hover .nav-icon,
            .admin-nav-link.active .nav-icon {
                background: #10b5a4;
                color: #ffffff;
                box-shadow: 0 4px 10px rgba(16, 181, 164, 0.18);
            }


            /* DIVIDER */

            .sidebar-divider {
                border: 0;
                border-top: 1px solid #e5f1ef;
                margin: 22px 14px;
            }


            /* LOGOUT */

            .logout-link {
                color: #c45b5b;
            }

                .logout-link:hover {
                    background: #fff4f4;
                    color: #b23b3b;
                    border-color: #f5dada;
                    transform: translateX(3px);
                }

                .logout-link .nav-icon {
                    color: #c45b5b;
                    background: #fff4f4;
                }

                .logout-link:hover .nav-icon {
                    background: #c45b5b;
                    color: #ffffff;
                }
            /* =========================================
                       MAIN CONTENT
                       ========================================= */

            .admin-main {
                width: calc(100% - 255px);
                margin-left: 255px;
                min-height: 100vh;
                background: #f4fbf9;
            }


            /* TOP BAR */

            .admin-topbar {
                height: 72px;
                background: #ffffff;
                border-bottom: 1px solid #dcefeb;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 35px;
            }

            .topbar-title {
                color: #163b38;
                font-size: 15px;
                font-weight: 700;
            }

            .topbar-status {
                display: flex;
                align-items: center;
                gap: 9px;
                color: #63817e;
                font-size: 13px;
            }

            .status-dot {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: #10b5a4;
            }


            /* CONTENT */

            .admin-content {
                padding: 0;
            }


            /* =========================================
                       RESPONSIVE
                       ========================================= */

            @@media (max-width: 900px) {

                .admin-sidebar {
                    width: 215px;
                }

                .admin-main {
                    width: calc(100% - 215px);
                    margin-left: 215px;
                }

                .admin-topbar {
                    padding: 0 22px;
                }
            }


            @@media (max-width: 700px) {

                .admin-sidebar {
                    position: relative;
                    width: 100%;
                    min-height: auto;
                    border-right: none;
                    border-bottom: 1px solid #dcefeb;
                }

                .admin-layout {
                    display: block;
                }

                .admin-main {
                    width: 100%;
                    margin-left: 0;
                }

                .admin-nav {
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                }

                .admin-topbar {
                    display: none;
                }
            }
            /* ================================
               SkillBridge Admin Scrollbar
               ================================ */

            html {
                scrollbar-width: thin;
                scrollbar-color: #10B5A4 #E8F8F5;
            }

            body::-webkit-scrollbar {
                width: 10px;
            }

            body::-webkit-scrollbar-track {
                background: #E8F8F5;
            }

            body::-webkit-scrollbar-thumb {
                background: #10B5A4;
                border-radius: 10px;
                border: 2px solid #E8F8F5;
            }

                body::-webkit-scrollbar-thumb:hover {
                    background: #07998C;
                }

            .nav-icon svg {
                width: 19px;
                height: 19px;
                display: block;
            }

            .sidebar-logo {
                font-size: 30px;
                font-weight: 850;
                letter-spacing: -1.2px;
                color: #163B38;
            }

                .sidebar-logo span {
                    color: #10B5A4;
                }

            .sidebar-tagline {
                margin-top: 8px;
                color: #6A8885;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 2.5px;
            }

            .admin-nav-link {
                min-height: 50px;
                border: 1px solid transparent;
            }

                .admin-nav-link:hover {
                    transform: translateX(3px);
                }

                .admin-nav-link.active {
                    background: #E8F8F5;
                    color: #087F73;
                    border-color: #C7EEE8;
                    box-shadow: 0 4px 12px rgba(16, 181, 164, 0.08);
                }

                    .admin-nav-link.active .nav-icon {
                        background: #10B5A4;
                        color: #FFFFFF;
                    }

            .nav-icon {
                transition: all 0.2s ease;
            }

            .admin-nav-link:hover .nav-icon {
                background: #10B5A4;
                color: #FFFFFF;
            }

    </style>
</head>

<body>

    <div class="admin-layout">

        <!-- =====================================
             SIDEBAR
             ===================================== -->

        <aside class="admin-sidebar">

            <div class="sidebar-brand">

                <div class="sidebar-logo">
                    Skill<span>Bridge</span>
                </div>

                <div class="sidebar-tagline">
                    AI CAREER PLATFORM
                </div>

            </div>


            <div class="sidebar-label">
                ADMINISTRATION
            </div>


            <nav class="admin-nav">

                <!-- Dashboard -->
                <a asp-page="/Admin/Dashboard"
                   class="admin-nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Dashboard" ? "active" : "")">

                    <span class="nav-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 10.5L12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1V10.5Z"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                  stroke-linejoin="round" />
                        </svg>
                    </span>

                    <span>Dashboard</span>

                </a>


                <!-- Users -->
                <a asp-page="/Admin/Users"
                   class="admin-nav-link">

                    <span class="nav-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="9" cy="8" r="3"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8" />

                            <circle cx="17" cy="9" r="2.5"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8" />

                            <path d="M3.5 19c0-3 2.4-5 5.5-5s5.5 2 5.5 5"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                  stroke-linecap="round" />

                            <path d="M15 14.5c2.8.1 5 1.8 5 4.5"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                  stroke-linecap="round" />
                        </svg>
                    </span>

                    <span>
                        Manage Users
                    </span>

                </a>


                <!-- Jobs -->
                <a asp-page="/Admin/Jobs"
                   class="admin-nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Jobs" ? "active" : "")">

                    <span class="nav-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="4" y="7"
                                  width="16"
                                  height="12"
                                  rx="2"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="1.8" />

                            <path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="1.8" />

                            <path d="M4 11h16"
                                  stroke="currentColor"
                                  stroke-width="1.8" />

                            <path d="M10 11v2h4v-2"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="1.8" />
                        </svg>
                    </span>

                    <span>Manage Jobs</span>

                </a>


                <!-- Resumes -->
                <a asp-page="/Admin/Resumes"
                   class="admin-nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Resumes" ? "active" : "")">

                    <span class="nav-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M6 3.5h8l4 4V20a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1Z"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                  stroke-linejoin="round" />

                            <path d="M14 3.5V8h4"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                  stroke-linejoin="round" />

                            <path d="M8 12h8M8 15h8M8 18h5"
                                  stroke="currentColor"
                                  stroke-width="1.6"
                                  stroke-linecap="round" />
                        </svg>
                    </span>

                    <span>Resumes</span>

                </a>


                <!-- Admin Profile -->
                <a asp-page="/Admin/Profile"
                   class="admin-nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Profile" ? "active" : "")">

                    <span class="nav-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="8" r="3.2"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8" />

                            <path d="M5 20c.7-3.4 3.2-5.3 7-5.3s6.3 1.9 7 5.3"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                  stroke-linecap="round" />
                        </svg>
                    </span>

                    <span>Admin Profile</span>

                </a>

            </nav>


            <hr class="sidebar-divider" />


            <!-- Logout -->
            <a asp-page="/Account/Login"
               class="admin-nav-link logout-link">

                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M10 5H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round" />

                        <path d="M14 8l4 4-4 4M9 12h9"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round"
                              stroke-linejoin="round" />
                    </svg>
                </span>

                <span>Logout</span>

            </a>

        </aside>


        <!-- =====================================
             MAIN AREA
             ===================================== -->

        <main class="admin-main">

            <header class="admin-topbar">

                <div class="topbar-title">
                    @ViewData["Title"]
                </div>

                <div class="topbar-status">

                    <span class="status-dot"></span>

                    Admin session active

                </div>

            </header>


            <div class="admin-content">

                @RenderBody()

            </div>

        </main>

    </div>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>
</html>