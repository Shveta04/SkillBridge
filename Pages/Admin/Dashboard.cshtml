@page "/Admin/Dashboard"
@model SkillBridge.Pages.Admin.DashboardModel

@{
    Layout = "/Pages/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="admin-dashboard">

    <!-- Welcome Header -->
    <section class="dashboard-header">

        <div>
            <span class="dashboard-label">
                SKILLBRIDGE ADMINISTRATION
            </span>

            <h1>Admin Dashboard</h1>

            <p>
                Manage users, job opportunities and resumes
                from your SkillBridge administration panel.
            </p>
        </div>

        <div class="login-icon">
            <svg width="30"
                 height="30"
                 viewBox="0 0 24 24"
                 fill="none"
                 xmlns="http://www.w3.org/2000/svg">

                <path d="M12 3L19 6V11C19 15.5 16.2 19.2 12 21C7.8 19.2 5 15.5 5 11V6L12 3Z"
                      fill="#10B5A4" />

                <path d="M12 6L16.5 7.9V11C16.5 13.9 14.8 16.4 12 17.8C9.2 16.4 7.5 13.9 7.5 11V7.9L12 6Z"
                      fill="#E8F8F5" />
            </svg>
        </div>

    </section>


    <!-- Administration Section -->
    <section class="dashboard-section">

        <div class="section-heading">
            <div>
                <h2>Administration</h2>
                <p>Manage the main areas of your SkillBridge platform.</p>
            </div>
        </div>


        <div class="admin-cards">

            <!-- Users -->
            <div class="admin-card">

                <div class="card-icon users-icon">
                    👥
                </div>

                <div class="card-content">

                    <span class="card-category">
                        USER MANAGEMENT
                    </span>

                    <h3>Users</h3>

                    <p>
                        View and manage registered SkillBridge users,
                        their contact information and account roles.
                    </p>

                    <a asp-page="/Admin/Users"
                       class="admin-card-button">
                        Manage Users
                        <span>→</span>
                    </a>

                </div>

            </div>


            <!-- Jobs -->
            <div class="admin-card">

                <div class="card-icon jobs-icon">
                    💼
                </div>

                <div class="card-content">

                    <span class="card-category">
                        JOB MANAGEMENT
                    </span>

                    <h3>Jobs</h3>

                    <p>
                        View, manage and maintain job postings
                        available to SkillBridge users.
                    </p>

                    <a asp-page="/Admin/Jobs"
                       class="admin-card-button">
                        Manage Jobs
                        <span>→</span>
                    </a>

                </div>

            </div>


            <!-- Resumes -->
            <div class="admin-card">

                <div class="card-icon resumes-icon">
                    📄
                </div>

                <div class="card-content">

                    <span class="card-category">
                        RESUME MANAGEMENT
                    </span>

                    <h3>Resumes</h3>

                    <p>
                        View submitted resumes and review
                        candidate information from the admin panel.
                    </p>

                    <a asp-page="/Admin/Resumes"
                       class="admin-card-button">
                        View Resumes
                        <span>→</span>
                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- Quick Information -->
    <section class="dashboard-info">

        <div class="info-item">
            <span class="info-icon">✓</span>

            <div>
                <strong>Centralized management</strong>
                <p>Control your SkillBridge platform from one place.</p>
            </div>
        </div>

        <div class="info-item">
            <span class="info-icon">✓</span>

            <div>
                <strong>Secure administration</strong>
                <p>Only authorized administrators can access this panel.</p>
            </div>
        </div>

        <div class="info-item">
            <span class="info-icon">✓</span>

            <div>
                <strong>Career ecosystem</strong>
                <p>Manage users, opportunities and candidate resumes.</p>
            </div>
        </div>

    </section>

</div>


<style>

    .admin-dashboard {
        padding: 30px 35px 50px;
        color: #163b38;
    }

    /* Header */

    .dashboard-header {
        background: #ffffff;
        border: 1px solid #dcefeb;
        border-radius: 24px;
        padding: 38px 42px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(22, 59, 56, 0.06);
    }

    .dashboard-label {
        color: #10b5a4;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .dashboard-header h1 {
        margin: 8px 0 8px;
        font-size: 42px;
        font-weight: 800;
        color: #163b38;
    }

    .dashboard-header p {
        margin: 0;
        color: #63817e;
        font-size: 17px;
    }

    .admin-badge {
        background: #e8f8f5;
        color: #07998c;
        border: 1px solid #c7eee8;
        padding: 12px 20px;
        border-radius: 50px;
        font-weight: 700;
        white-space: nowrap;
    }


    /* Administration */

    .dashboard-section {
        background: #ffffff;
        border: 1px solid #dcefeb;
        border-radius: 24px;
        padding: 38px 42px;
        box-shadow: 0 10px 30px rgba(22, 59, 56, 0.05);
    }

    .section-heading h2 {
        margin: 0;
        font-size: 30px;
        font-weight: 800;
        color: #163b38;
    }

    .section-heading p {
        margin: 6px 0 28px;
        color: #6a8885;
        font-size: 16px;
    }


    /* Cards */

    .admin-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 22px;
    }

    .admin-card {
        background: #f8fcfb;
        border: 1px solid #d9eeea;
        border-radius: 20px;
        padding: 25px;
        transition: all 0.25s ease;
    }

        .admin-card:hover {
            transform: translateY(-5px);
            border-color: #10b5a4;
            box-shadow: 0 15px 30px rgba(16, 181, 164, 0.12);
        }

    .card-icon {
        width: 55px;
        height: 55px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
        margin-bottom: 20px;
    }

    .users-icon {
        background: #e8f8f5;
    }

    .jobs-icon {
        background: #eefaf8;
    }

    .resumes-icon {
        background: #e4f6f2;
    }

    .card-category {
        color: #10b5a4;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.5px;
    }

    .card-content h3 {
        margin: 5px 0 10px;
        font-size: 25px;
        font-weight: 800;
        color: #163b38;
    }

    .card-content p {
        color: #688783;
        line-height: 1.7;
        min-height: 82px;
        margin-bottom: 22px;
    }

    .admin-card-button {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #10b5a4;
        color: #ffffff;
        text-decoration: none;
        padding: 13px 17px;
        border-radius: 12px;
        font-weight: 700;
        transition: all 0.2s ease;
    }

        .admin-card-button:hover {
            background: #07998c;
            color: #ffffff;
            transform: translateY(-1px);
        }

        .admin-card-button span {
            font-size: 20px;
        }


    /* Information */

    .dashboard-info {
        margin-top: 25px;
        background: #e8f8f5;
        border: 1px solid #ccece7;
        border-radius: 20px;
        padding: 25px 30px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }

    .info-item {
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }

    .info-icon {
        width: 30px;
        height: 30px;
        min-width: 30px;
        border-radius: 50%;
        background: #10b5a4;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }

    .info-item strong {
        color: #163b38;
    }

    .info-item p {
        margin: 4px 0 0;
        color: #63817e;
        font-size: 13px;
        line-height: 1.5;
    }


    /* Responsive */

    @@media (max-width: 1000px) {

        .admin-cards {
            grid-template-columns: 1fr;
        }

        .dashboard-info {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 700px) {

        .admin-dashboard {
            padding: 20px;
        }

        .dashboard-header {
            padding: 28px;
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }

            .dashboard-header h1 {
                font-size: 34px;
            }

        .dashboard-section {
            padding: 28px;
        }
    }

</style>