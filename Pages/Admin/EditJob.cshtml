@page "/Admin/EditJob"
@model SkillBridge.Pages.Admin.EditJobModel

@{
    Layout = "/Pages/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Job";
}

<style>
    .edit-job-page {
        padding: 36px 44px;
        background: #f2faf8;
        min-height: calc(100vh - 80px);
    }

    .edit-job-header {
        background: #ffffff;
        border: 1px solid #d6eeea;
        border-radius: 24px;
        padding: 34px 42px;
        margin-bottom: 28px;
    }

    .edit-job-label {
        color: #10b3a3;
        font-size: 14px;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .edit-job-header h1 {
        margin: 0;
        color: #123b36;
        font-size: 42px;
        font-weight: 800;
    }

    .edit-job-header p {
        margin: 10px 0 0;
        color: #64817d;
        font-size: 17px;
    }

    .edit-job-card {
        background: #ffffff;
        border: 1px solid #d6eeea;
        border-radius: 24px;
        padding: 34px 42px;
        box-shadow: 0 8px 24px rgba(16, 179, 163, 0.06);
    }

    .edit-job-card h2 {
        color: #123b36;
        font-size: 26px;
        font-weight: 800;
        margin-bottom: 28px;
    }

    .edit-job-form label {
        color: #315f59;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .edit-job-form .form-control {
        border: 1px solid #c9e8e3;
        border-radius: 10px;
        padding: 11px 14px;
        font-size: 14px;
        color: #294e49;
        background: #ffffff;
        box-shadow: none;
    }

    .edit-job-form .form-control:focus {
        border-color: #10b3a3;
        box-shadow: 0 0 0 3px rgba(16, 179, 163, 0.10);
    }

    .edit-job-form textarea.form-control {
        resize: vertical;
        min-height: 140px;
    }

    .edit-job-actions {
        display: flex;
        gap: 12px;
        margin-top: 30px;
    }

    .save-job-btn {
        display: inline-block;
        background: #10b3a3;
        color: #ffffff;
        border: 1px solid #10b3a3;
        border-radius: 10px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .save-job-btn:hover {
        background: #008d83;
        border-color: #008d83;
        color: #ffffff;
    }

    .cancel-job-btn {
        display: inline-block;
        background: #e9f8f6;
        color: #008d83;
        border: 1px solid #c9ece7;
        border-radius: 10px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        transition: 0.2s ease;
    }

    .cancel-job-btn:hover {
        background: #d8f2ee;
        color: #00776f;
    }

    .validation-error {
        font-size: 12px;
        margin-top: 5px;
    }
    /* Delete button */
    .delete-job-btn {
        margin-left: auto;
        display: inline-block;
        background: #fff1f0;
        color: #d9534f;
        border: 1px solid #f0c7c5;
        border-radius: 10px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s ease;
    }

        .delete-job-btn:hover {
            background: #d9534f;
            color: #ffffff;
        }

    /* Delete confirmation modal */
    .delete-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(18, 59, 54, 0.45);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .delete-modal {
        width: 100%;
        max-width: 460px;
        background: #ffffff;
        border: 1px solid #d6eeea;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 20px 60px rgba(18, 59, 54, 0.20);
    }

    .delete-modal-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #fff1f0;
        color: #d9534f;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        font-weight: 800;
        margin-bottom: 18px;
    }

    .delete-modal h3 {
        margin: 0 0 10px;
        color: #123b36;
        font-size: 22px;
        font-weight: 800;
    }

    .delete-modal p {
        margin: 0;
        color: #64817d;
        font-size: 14px;
        line-height: 1.6;
    }

    .delete-modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 24px;
    }

    .delete-cancel-btn {
        background: #e9f8f6;
        color: #008d83;
        border: 1px solid #c9ece7;
        border-radius: 10px;
        padding: 10px 18px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
    }

        .delete-cancel-btn:hover {
            background: #d8f2ee;
        }

    .delete-confirm-btn {
        background: #d9534f;
        color: #ffffff;
        border: 1px solid #d9534f;
        border-radius: 10px;
        padding: 10px 18px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
    }

        .delete-confirm-btn:hover {
            background: #c9302c;
        }

    @@media (max-width: 768px) {
        .edit-job-page {
            padding: 24px 18px;
        }

        .edit-job-header,
        .edit-job-card {
            padding: 26px 22px;
        }

        .edit-job-header h1 {
            font-size: 32px;
        }
    }
</style>

<div class="edit-job-page">

    <!-- Header -->
    <div class="edit-job-header">

        <div class="edit-job-label">
            JOB MANAGEMENT
        </div>

        <h1>Edit Job</h1>

        <p>
            Update and manage this SkillBridge job posting.
        </p>

    </div>


    <!-- Form -->
    <div class="edit-job-card">

        <h2>Job Information</h2>

        <form method="post" class="edit-job-form">

            <input type="hidden" asp-for="Job.JobID" />

            <div class="row g-4">

                <!-- Job Title -->
                <div class="col-md-6">

                    <label asp-for="Job.JobTitle" class="form-label">
                        Job Title
                    </label>

                    <input asp-for="Job.JobTitle"
                           class="form-control"
                           placeholder="Enter job title" />

                    <span asp-validation-for="Job.JobTitle"
                          class="text-danger validation-error">
                    </span>

                </div>


                <!-- Company -->
                <div class="col-md-6">

                    <label asp-for="Job.CompanyName" class="form-label">
                        Company
                    </label>

                    <input asp-for="Job.CompanyName"
                           class="form-control"
                           placeholder="Enter company name" />

                    <span asp-validation-for="Job.CompanyName"
                          class="text-danger validation-error">
                    </span>

                </div>


                <!-- Location -->
                <div class="col-md-6">

                    <label asp-for="Job.Location" class="form-label">
                        Location
                    </label>

                    <input asp-for="Job.Location"
                           class="form-control"
                           placeholder="Enter location" />

                    <span asp-validation-for="Job.Location"
                          class="text-danger validation-error">
                    </span>

                </div>


                <!-- Job Type -->
                <div class="col-md-6">

                    <label asp-for="Job.JobType" class="form-label">
                        Job Type
                    </label>

                    <input asp-for="Job.JobType"
                           class="form-control"
                           placeholder="Full Time / Part Time / Remote" />

                    <span asp-validation-for="Job.JobType"
                          class="text-danger validation-error">
                    </span>

                </div>


                <!-- Required Skills -->
                <div class="col-12">

                    <label asp-for="Job.RequiredSkills" class="form-label">
                        Required Skills
                    </label>

                    <input asp-for="Job.RequiredSkills"
                           class="form-control"
                           placeholder="C#, ASP.NET Core, SQL Server..." />

                    <span asp-validation-for="Job.RequiredSkills"
                          class="text-danger validation-error">
                    </span>

                </div>


                <!-- Apply Link -->
                <div class="col-12">

                    <label asp-for="Job.ApplyLink" class="form-label">
                        Apply Link
                    </label>

                    <input asp-for="Job.ApplyLink"
                           class="form-control"
                           placeholder="https://example.com/apply" />

                    <span asp-validation-for="Job.ApplyLink"
                          class="text-danger validation-error">
                    </span>

                </div>


                <!-- Description -->
                <div class="col-12">

                    <label asp-for="Job.Description" class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Job.Description"
                              class="form-control"
                              rows="6"
                              placeholder="Enter job description">
                    </textarea>

                    <span asp-validation-for="Job.Description"
                          class="text-danger validation-error">
                    </span>

                </div>

            </div>


            <!-- Buttons -->
            <div class="d-flex gap-2 align-items-center mt-4">

                <button type="submit"
                        class="btn"
                        style="background-color:#10b3a3; color:white; border:none; border-radius:8px; padding:10px 20px; font-weight:600;">
                    Save Changes
                </button>

                <a asp-page="/Admin/Jobs"
                   class="btn"
                   style="background-color:#f1f5f4; color:#008d83; border:1px solid #c9ece7; border-radius:8px; padding:10px 20px; font-weight:600;">
                    Cancel
                </a>

                <button type="button"
                        class="delete-job-btn"
                        onclick="openDeleteModal()">
                    Delete Job
                </button>

            </div>

        </form>

    </div>

</div>
    </div>

</div>


<!-- Delete Confirmation Modal -->
<div id="deleteModal"
     class="delete-modal-overlay">

    <div class="delete-modal">

        <div class="delete-modal-icon">
            !
        </div>

        <h3>Delete Job?</h3>

        <p>
            Are you sure you want to delete this job?
            This action cannot be undone.
        </p>

        <div class="delete-modal-actions">

            <button type="button"
                    class="delete-cancel-btn"
                    onclick="closeDeleteModal()">
                Cancel
            </button>

            <form method="post"
                  asp-page-handler="Delete"
                  asp-route-id="@Model.Job.JobID">

                <button type="submit"
                        class="delete-confirm-btn">
                    Delete Job
                </button>

            </form>

        </div>

    </div>

</div>



@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        function openDeleteModal() {
            document.getElementById("deleteModal").style.display = "flex";
        }

        function closeDeleteModal() {
            document.getElementById("deleteModal").style.display = "none";
        }

        document.getElementById("deleteModal").addEventListener("click", function (event) {
            if (event.target === this) {
                closeDeleteModal();
            }
        });

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                closeDeleteModal();
            }
        });
    </script>
}