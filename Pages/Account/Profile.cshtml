@page
@model SkillBridge.Pages.Account.ProfileModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5">

    <div class="mb-4">
        <h1 class="fw-bold text-dark">My Profile</h1>
        <p class="text-secondary">
            View your SkillBridge account information.
        </p>
    </div>

    @if (Model.CurrentUser != null)
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body p-4">

                <div class="row">

                    <!-- Profile header -->
                    <div class="col-md-4 text-center border-end">

                        <div class="rounded-circle bg-primary text-white
                            d-flex align-items-center justify-content-center
                            mx-auto mb-3"
                             style="width:110px;height:110px;font-size:45px;">
                            👤
                        </div>

                        <h3 class="fw-bold">
                            @Model.CurrentUser.FullName
                        </h3>

                        <span class="badge bg-primary">
                            SkillBridge User
                        </span>

                    </div>

                    <!-- Information -->
                    <div class="col-md-8">

                        <h4 class="fw-bold mb-4">
                            Account Information
                        </h4>

                        <div class="mb-3">
                            <label class="fw-semibold">
                                Full Name
                            </label>

                            <div class="form-control bg-light">
                                @Model.CurrentUser.FullName
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="fw-semibold">
                                Email Address
                            </label>

                            <div class="form-control bg-light">
                                @Model.CurrentUser.Email
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="fw-semibold">
                                Contact Number
                            </label>

                            <div class="form-control bg-light">
                                @(string.IsNullOrWhiteSpace(Model.CurrentUser.Phone)
                                    ? "Not provided"
                                    : Model.CurrentUser.Phone)
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="fw-semibold">
                                Skills
                            </label>

                            <div class="form-control bg-light">
                                @(string.IsNullOrWhiteSpace(Model.CurrentUser.Skills)
                                    ? "No skills added yet."
                                    : Model.CurrentUser.Skills)
                            </div>
                        </div>

                        <div class="mt-4">

                            @if (!string.IsNullOrEmpty(Model.CurrentUser.ResumePath))
                            {
                                <a href="@Model.CurrentUser.ResumePath"
                                   target="_blank"
                                   class="btn btn-primary">
                                    📄 View My Resume
                                </a>
                            }
                            else
                            {
                                <span class="text-secondary">
                                    No resume uploaded.
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>
    }

</div>